# Copy to .env and fill in. All values are optional in OFFLINE mode.

# --- LLM provider (OpenAI-compatible) ---
# Works with OpenAI, DeepSeek, Together, Groq, local vLLM/Ollama, etc.
OPENAI_API_KEY=sk-...
# Override base_url for non-OpenAI providers, e.g.:
#   DeepSeek:  https://api.deepseek.com/v1
#   Together:  https://api.together.xyz/v1
#   Ollama:    http://localhost:11434/v1
# OPENAI_BASE_URL=

# Model used for the synthesis step.
COLD_START_MODEL=gpt-4o-mini

# --- Behaviour ---
COLD_START_TEMPERATURE=0.2
COLD_START_MAX_TOKENS=2000

# Set to 1/true to skip all network calls and use the deterministic,
# corpus-grounded fallback synthesis (no API key needed).
COLD_START_OFFLINE=
